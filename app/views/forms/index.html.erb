<% if user_signed_in? %>
  <div class="forms-page">
    <div class="page-header">
      <h1>My Forms</h1>
      <%= link_to "Create New Form", new_form_path, class: "btn btn-primary" %>
    </div>

    <% if @forms.any? %>
      <div class="forms-grid">
        <% @forms.each do |form| %>
          <div class="form-card">
            <div class="form-card-header">
              <h3><%= form.title %></h3>
              <div class="form-actions">
                <%= link_to "View", form_path(form), class: "btn btn-sm btn-outline" %>
                <% if form.editable? %>
                  <%= link_to "Edit", edit_form_path(form), class: "btn btn-sm btn-outline" %>
                <% else %>
                  <span class="btn btn-sm btn-outline disabled" title="Form is locked because it has entries">Edit (Locked)</span>
                <% end %>
                <%= button_to "Delete", form_path(form), method: :delete, 
                             class: "btn btn-sm btn-danger", 
                             confirm: "Are you sure you want to delete this form?" %>
              </div>
            </div>
            <div class="form-card-body">
              <p class="form-meta">
                Created: <%= form.created_at.strftime("%B %d, %Y") %>
              </p>
              <p class="form-meta">
                Fields: <%= form.form_fields.count %>
              </p>
              <p class="form-meta">
                Entries: <%= form.form_entries.count %>
              </p>
              <p class="form-meta">
                Status: 
                <% if form.editable? %>
                  <span class="status-editable">Editable</span>
                <% else %>
                  <span class="status-locked">Locked</span>
                <% end %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h2>No forms yet</h2>
        <p>Create your first form to get started!</p>
        <%= link_to "Create New Form", new_form_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="welcome-page">
    <h1>Welcome to Form Management System</h1>
    <p>Create and manage forms with ease. Get started by signing up or signing in.</p>
    
    <div class="auth-links">
      <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary" %>
      <%= link_to "Sign In", new_user_session_path, class: "btn btn-secondary" %>
    </div>
    
    <div class="features">
      <h2>Features</h2>
      <ul>
        <li>Create custom forms with different field types</li>
        <li>Add validations to your fields</li>
        <li>Fill forms multiple times</li>
        <li>View all form entries in a table format</li>
        <li>Export data as CSV</li>
      </ul>
    </div>
  </div>
<% end %>
